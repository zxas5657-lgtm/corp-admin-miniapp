.page {
  box-sizing: border-box;
  width: 100%;
  min-height: 100vh;
  padding: var(--space-12, 12px) var(--space-16, 16px) 180px;
  padding-bottom: calc(180px + constant(safe-area-inset-bottom));
  padding-bottom: calc(180px + env(safe-area-inset-bottom));
}

.filters {
  width: 100%;
  height: 52px;
  margin-bottom: var(--space-8, 8px);
  white-space: nowrap;
}

.chip {
  display: inline-flex;
  align-items: center;
  box-sizing: border-box;
  min-height: 44px;
  margin-right: var(--space-8, 8px);
  padding: 0 var(--space-14, 14px);
  border-radius: 999px;
  background: #FFFFFF;
  color: var(--ink-2, #5C6778);
  font-size: 14px;
  line-height: 1.2;
}

.chip.is-on {
  background: var(--primary-soft, #E7F0FA);
  color: var(--primary, #1F4E89);
  font-weight: 600;
}

.card-line {
  display: flex;
  align-items: flex-start;
}

.card-title {
  flex: 1;
  min-width: 0;
  margin-right: var(--space-8, 8px);
  font-size: 16px;
  font-weight: 600;
  line-height: 1.35;
  word-break: break-word;
}

.pill-host {
  flex: none;
  max-width: 46%;
}

.meta {
  display: block;
  margin-top: var(--space-4, 4px);
  word-break: break-word;
}

.is-cancelled .card-title,
.is-cancelled .meta {
  color: var(--ink-3, #6B7585);
}

.is-strike {
  text-decoration: line-through;
}

.dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(64px + constant(safe-area-inset-bottom));
  bottom: calc(64px + env(safe-area-inset-bottom));
  z-index: 20;
  box-sizing: border-box;
  padding: var(--space-10, 10px) var(--space-16, 16px);
  background: #FFFFFF;
  border-top: 1px solid var(--line, #E6E9EE);
}

.is-pressed {
  background: #F7F9FB;
}
