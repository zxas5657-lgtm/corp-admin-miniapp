.page {
  box-sizing: border-box;
  width: 100%;
  min-height: 100vh;
  padding: var(--space-16, 16px) var(--space-16, 16px) calc(var(--space-24, 24px) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--space-24, 24px) + env(safe-area-inset-bottom));
}

.page.has-action {
  padding-bottom: calc(96px + constant(safe-area-inset-bottom));
  padding-bottom: calc(96px + env(safe-area-inset-bottom));
}

.title-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: var(--space-16, 16px);
}

.title {
  flex: 1;
  min-width: 0;
  margin-right: var(--space-8, 8px);
  word-break: break-word;
}

.pill-host {
  flex: none;
  max-width: 46%;
  margin-top: var(--space-2, 2px);
}

.steps {
  position: relative;
  display: flex;
  margin-bottom: var(--space-16, 16px);
}

.step-line {
  position: absolute;
  top: 7px;
  left: 16%;
  right: 16%;
  height: 2px;
  background: var(--icon, #8B95A5);
}

.step {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.step-dot {
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: var(--icon, #8B95A5);
}

.step-dot.is-done {
  background: var(--ok, #146C3F);
}

.step-dot.is-current {
  background: var(--primary, #1F4E89);
}

.step-label,
.step-time {
  display: block;
  max-width: 100%;
  margin-top: var(--space-6, 6px);
  font-size: 12px;
  line-height: 1.35;
  text-align: center;
  word-break: break-word;
}

.step-time {
  margin-top: var(--space-2, 2px);
  color: var(--ink-3, #6B7585);
}

.warn-note {
  display: block;
  box-sizing: border-box;
  margin-top: var(--space-8, 8px);
  padding: var(--space-8, 8px) var(--space-12, 12px);
  border-radius: 8px;
  background: var(--warn-soft, #FBF3E6);
  color: var(--warn, #8A4B0F);
  font-size: 12px;
  line-height: 1.45;
  word-break: break-word;
}

.text-action {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  min-height: 44px;
  margin-top: var(--space-8, 8px);
  color: var(--primary, #1F4E89);
  font-size: 16px;
  font-weight: 600;
  line-height: 1.35;
}

.text-action.is-danger {
  color: var(--danger, #9F1D1D);
}

.car {
  display: flex;
  align-items: flex-start;
  box-sizing: border-box;
  min-height: 44px;
  margin-bottom: var(--space-8, 8px);
  padding: var(--space-8, 8px) 0;
}

.car.is-off {
  opacity: 0.45;
}

.radio {
  flex: none;
  width: 18px;
  height: 18px;
  margin-top: var(--space-2, 2px);
  margin-right: var(--space-10, 10px);
  border: 1.5px solid var(--icon, #8B95A5);
  border-radius: 50%;
  box-sizing: border-box;
}

.radio.is-on {
  border-color: var(--primary, #1F4E89);
  box-shadow: inset 0 0 0 4px var(--primary, #1F4E89);
}

.car-copy {
  flex: 1;
  min-width: 0;
}

.car-label,
.car-meta,
.car-busy,
.sheet-copy,
.err {
  display: block;
  word-break: break-word;
  overflow-wrap: break-word;
}

.car-meta,
.car-busy,
.sheet-copy {
  margin-top: var(--space-2, 2px);
  color: var(--ink-2, #5C6778);
  font-size: 13px;
  line-height: 1.45;
}

.car-busy {
  color: var(--warn, #8A4B0F);
}

.reason {
  box-sizing: border-box;
  width: 100%;
  min-height: 88px;
  font-size: 15px;
  line-height: 1.45;
}

.err {
  margin-top: var(--space-6, 6px);
  color: var(--danger, #9F1D1D);
  font-size: 12px;
  line-height: 1.4;
}

.sheet-copy {
  white-space: normal;
}

.is-pressed {
  opacity: 0.7;
}
