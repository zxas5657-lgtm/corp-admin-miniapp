.page {
  box-sizing: border-box;
  width: 100%;
  min-height: 100vh;
  padding: var(--space-12, 12px) var(--space-16, 16px) var(--space-24, 24px);
  padding-bottom: calc(var(--space-24, 24px) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--space-24, 24px) + env(safe-area-inset-bottom));
}

.field-input,
.picker-hit {
  box-sizing: border-box;
  width: 100%;
  min-height: 44px;
  text-align: right;
  font-size: 15px;
}

.field-input {
  height: 44px;
  line-height: 44px;
}

.picker-hit {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  line-height: 1.4;
  word-break: break-word;
}

.stepper {
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.step-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 44px;
  min-height: 44px;
  border-radius: 8px;
  background: var(--mute-soft, #EEF1F5);
  color: var(--ink, #1C2430);
  font-size: 20px;
  line-height: 1;
}

.step-btn.is-off {
  opacity: 0.4;
}

.step-value {
  min-width: 28px;
  margin: 0 var(--space-8, 8px);
  font-size: 16px;
  font-weight: 600;
  text-align: center;
  font-variant-numeric: tabular-nums;
}

.field-area {
  box-sizing: border-box;
  width: 100%;
  min-height: 88px;
  padding: var(--space-8, 8px) 0;
  text-align: left;
  font-size: 15px;
  line-height: 1.45;
}

.submit {
  margin-top: var(--space-16, 16px);
}

.sheet-copy {
  display: block;
  color: var(--ink-2, #5C6778);
  font-size: 14px;
  line-height: 1.5;
  white-space: normal;
  word-break: break-word;
  overflow-wrap: break-word;
}
