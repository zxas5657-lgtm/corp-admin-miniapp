.page {
  box-sizing: border-box;
  width: 100%;
  min-height: 100vh;
  padding: var(--space-12, 12px) var(--space-16, 16px) calc(180px + constant(safe-area-inset-bottom));
  padding-bottom: calc(180px + env(safe-area-inset-bottom));
}

.segments {
  display: flex;
  width: 100%;
  margin-bottom: var(--space-12, 12px);
  padding: var(--space-4, 4px);
  border-radius: 10px;
  background: var(--mute-soft, #EEF1F5);
}

.segment {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  box-sizing: border-box;
  min-width: 0;
  min-height: 44px;
  padding: var(--space-8, 8px) var(--space-6, 6px);
  border-radius: 8px;
  color: var(--ink-2, #5C6778);
  font-size: 13px;
  line-height: 1.3;
  text-align: center;
  word-break: break-word;
}

.segment.is-on {
  background: #FFFFFF;
  color: var(--primary, #1F4E89);
  font-weight: 600;
}

.card-line {
  display: flex;
  align-items: flex-start;
}

.card-title {
  flex: 1;
  min-width: 0;
  margin-right: var(--space-8, 8px);
  font-size: 16px;
  font-weight: 600;
  line-height: 1.35;
  word-break: break-word;
}

.pill-host {
  flex: none;
  max-width: 46%;
}

.meta {
  display: block;
  margin-top: var(--space-4, 4px);
  word-break: break-word;
}

.dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(64px + constant(safe-area-inset-bottom));
  bottom: calc(64px + env(safe-area-inset-bottom));
  z-index: 20;
  box-sizing: border-box;
  padding: var(--space-10, 10px) var(--space-16, 16px);
  background: #FFFFFF;
  border-top: 1px solid var(--line, #E6E9EE);
}

.is-pressed {
  background: #F7F9FB;
}
