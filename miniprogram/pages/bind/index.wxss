.page {
  box-sizing: border-box;
  width: 100%;
  min-height: 100vh;
  padding: var(--space-24, 24px) var(--space-16, 16px);
  background: var(--bg, #F3F5F8);
}

.title {
  display: block;
  margin-bottom: var(--space-8, 8px);
  color: var(--ink, #1C2430);
  font-size: 20px;
  font-weight: 600;
  line-height: 1.35;
}

.lead,
.footer {
  display: block;
  color: var(--ink-2, #5C6778);
  font-size: 14px;
  line-height: 1.45;
}

.lead {
  margin-bottom: var(--space-16, 16px);
}

.code {
  box-sizing: border-box;
  width: 100%;
  height: 52px;
  margin-bottom: var(--space-8, 8px);
  padding: 0 var(--space-16, 16px);
  border-radius: 16px;
  background: #FFFFFF;
  color: var(--ink, #1C2430);
  font-size: 20px;
  font-weight: 600;
  letter-spacing: 2px;
  text-align: center;
}

.err {
  display: block;
  margin-bottom: var(--space-8, 8px);
  color: var(--cancel, #9B2C3C);
  font-size: 13px;
  line-height: 1.4;
}

.retry {
  display: flex;
  align-items: center;
  min-height: 44px;
  margin-bottom: var(--space-8, 8px);
  color: var(--accent, #8A4A22);
  font-size: 15px;
  font-weight: 600;
}

.consent {
  display: flex;
  align-items: flex-start;
  margin-top: var(--space-8, 8px);
  margin-bottom: var(--space-8, 8px);
}

.check {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 22px;
  height: 22px;
  margin-top: 1px;
  margin-right: var(--space-8, 8px);
  box-sizing: border-box;
  border: 1.5px solid var(--line, #E6E9EE);
  border-radius: 4px;
  background: #FFFFFF;
}

.check.is-on {
  border-color: var(--accent, #8A4A22);
  background: var(--accent, #8A4A22);
}

.tick-mark {
  width: 6px;
  height: 10px;
  margin-top: calc(-1 * var(--space-2, 2px));
  border-right: 2px solid #FFFFFF;
  border-bottom: 2px solid #FFFFFF;
  transform: rotate(45deg);
}

.consent-copy {
  flex: 1;
  min-width: 0;
  color: var(--ink, #1C2430);
  font-size: 14px;
  line-height: 1.45;
}

.policy {
  color: var(--accent, #8A4A22);
  font-weight: 600;
}

.policy.is-gap {
  margin-left: 4px;
}

.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: var(--space-8, 8px);
}

.spin {
  width: 16px;
  height: 16px;
  margin-right: var(--space-8, 8px);
  border: 2px solid rgba(255, 255, 255, 0.45);
  border-top-color: #FFFFFF;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.footer {
  margin-top: var(--space-24, 24px);
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
