<view class="page">
  <state-view wx:if="{{phase === 'loading'}}" kind="loading" />
  <state-view
    wx:elif="{{phase === 'error'}}"
    kind="error"
    title="{{errorTitle}}"
    body="{{errorBody}}"
    action-text="{{retryText}}"
    secondary-text="{{loadFailed ? i18n.state.reset : ''}}"
    bind:action="onRetry"
    bind:secondary="onReset"
  />
  <block wx:elif="{{view}}">
    <view wx:if="{{banner}}" id="created-banner" class="created-banner">
      <notice-bar
        kind="success"
        text="{{banner}}"
        closable="{{true}}"
        close-label="{{i18n.a11y.closeSheet}}"
        bind:close="onCloseBanner"
      />
    </view>
    <view class="pad">
      <view class="head">
        <text class="date">{{view.dayHeading}}</text>
        <text class="meetings-link" bindtap="onMeetings">{{meetingsLink}}</text>
        <text class="count">{{view.countText}}</text>
        <picker
          class="cal-picker"
          mode="date"
          value="{{view.date}}"
          bindchange="onPickDate"
        >
          <view class="cal" aria-role="button" aria-label="{{i18n.a11y.weekPicker}}">
            <view class="cal-icon" aria-hidden="true">
              <view class="cal-bar"></view>
            </view>
          </view>
        </picker>
        <view
          wx:if="{{view.backToToday}}"
          class="today"
          aria-role="button"
          hover-class="is-pressed"
          bindtap="onBackToday"
        >{{view.backToToday}}</view>
      </view>
      <view class="segments" wx:if="{{view.scopes.length}}">
        <view
          wx:for="{{view.scopes}}"
          wx:key="key"
          class="segment {{item.active ? 'is-on' : ''}}"
          data-key="{{item.key}}"
          aria-role="button"
          hover-class="is-pressed"
          bindtap="onScope"
        >{{item.label}}</view>
      </view>
    </view>

    <view class="week">
      <view
        class="nav-chev"
        data-date="{{view.week.prevDate}}"
        aria-role="button"
        hover-class="is-pressed"
        bindtap="onSelectDate"
      >
        <view class="chevron is-left" aria-hidden="true"></view>
      </view>
      <view class="days">
        <view
          wx:for="{{view.week.days}}"
          wx:key="date"
          class="day {{item.isSelected ? 'is-on' : ''}} {{item.isToday && !item.isSelected ? 'is-today' : ''}}"
          data-date="{{item.date}}"
          aria-role="button"
          hover-class="is-pressed"
          bindtap="onSelectDate"
        >
          <text class="weekday">{{item.weekday}}</text>
          <text class="day-num">{{item.dayNum}}</text>
          <view class="dot {{item.hasItems ? 'is-on' : ''}}"></view>
        </view>
      </view>
      <view
        class="nav-chev"
        data-date="{{view.week.nextDate}}"
        aria-role="button"
        hover-class="is-pressed"
        bindtap="onSelectDate"
      >
        <view class="chevron is-right" aria-hidden="true"></view>
      </view>
    </view>

    <view class="pad">
      <state-view
        wx:if="{{view.empty}}"
        kind="empty"
        title="{{view.empty.title}}"
        body="{{view.empty.body}}"
      />
      <block wx:else>
        <view
          wx:for="{{view.items}}"
          wx:key="id"
          id="item-{{item.id}}"
          class="card {{item.kind === 'vehicle' ? 'vehicle' : ''}} {{item.url ? 'is-link' : ''}} {{item.focused ? 'is-focus' : ''}}"
          data-kind="{{item.kind}}"
          data-url="{{item.url}}"
          hover-class="{{item.url ? 'is-pressed' : 'none'}}"
          bindtap="onOpenItem"
        >
          <view class="card-line">
            <text class="time">{{item.timeText}}</text>
            <status-pill class="pill-host" text="{{item.statusText}}" tone="{{item.tone}}" />
          </view>
          <view class="card-title">{{item.title}}</view>
          <text class="card-sub text-secondary">{{item.subtitle}}</text>
          <view wx:if="{{item.url}}" class="card-chev" aria-hidden="true"></view>
        </view>
      </block>
    </view>
  </block>
</view>
