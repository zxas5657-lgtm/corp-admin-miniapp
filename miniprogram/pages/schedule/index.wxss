.page {
  box-sizing: border-box;
  width: 100%;
  min-height: 100vh;
  padding-top: var(--space-12, 12px);
  padding-bottom: calc(88px + constant(safe-area-inset-bottom));
  padding-bottom: calc(88px + env(safe-area-inset-bottom));
}

.created-banner {
  position: sticky;
  top: 0;
  z-index: 5;
  box-sizing: border-box;
  padding-right: var(--space-16, 16px);
  padding-left: var(--space-16, 16px);
  background: var(--bg, #F3F5F8);
}

.pad {
  box-sizing: border-box;
  padding-right: var(--space-16, 16px);
  padding-left: var(--space-16, 16px);
}

.head {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.date {
  flex: 0 0 auto;
  order: 1;
  max-width: 100%;
  font-size: 16px;
  font-weight: 600;
  line-height: 1.35;
  white-space: nowrap;
}

.count {
  flex: 0 0 auto;
  order: 2;
  margin-left: auto;
  padding-left: var(--space-8, 8px);
  font-size: 12px;
  line-height: 1.4;
  color: var(--ink-3, #6B7585);
  white-space: nowrap;
}

.cal-picker {
  flex: 0 0 44px;
  order: 3;
  width: 44px;
  height: 44px;
}

.cal {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
}

.cal-icon {
  box-sizing: border-box;
  width: 16px;
  height: 16px;
  border: 1.5px solid var(--primary, #1F4E89);
  border-radius: 3px;
  padding-top: var(--space-4, 4px);
}

.cal-bar {
  height: 0;
  margin: 0 var(--space-2, 2px);
  border-top: 1.5px solid var(--primary, #1F4E89);
}

.segments {
  display: flex;
  width: 100%;
  margin-top: var(--space-4, 4px);
  padding: var(--space-2, 2px);
  border-radius: 8px;
  background: var(--mute-soft, #EEF1F5);
}

.segment {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  box-sizing: border-box;
  min-width: 0;
  min-height: 44px;
  padding: var(--space-6, 6px) var(--space-8, 8px);
  border-radius: 6px;
  color: var(--ink-2, #5C6778);
  font-size: 13px;
  line-height: 1.3;
  text-align: center;
  word-break: break-word;
}

.segment.is-on {
  background: #FFFFFF;
  color: var(--primary, #1F4E89);
  font-weight: 600;
}

.today {
  display: flex;
  align-items: center;
  flex: 0 0 100%;
  order: 4;
  box-sizing: border-box;
  min-height: 44px;
  color: var(--primary, #1F4E89);
  font-size: 14px;
  font-weight: 600;
  line-height: 1.35;
}

.week {
  display: flex;
  align-items: stretch;
  margin-top: var(--space-4, 4px);
  margin-bottom: var(--space-12, 12px);
  background: var(--card, #FFFFFF);
  box-shadow: var(--shadow, 0 1px 2px rgba(28, 36, 48, 0.04));
}

.nav-chev {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 44px;
  width: 44px;
  min-height: 44px;
}

.chevron {
  width: 8px;
  height: 8px;
  border-right: 1.5px solid var(--ink-2, #5C6778);
  border-bottom: 1.5px solid var(--ink-2, #5C6778);
}

.chevron.is-left {
  transform: rotate(135deg);
}

.chevron.is-right {
  transform: rotate(-45deg);
}

.days {
  display: flex;
  flex: 1;
  min-width: 0;
}

.day {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  box-sizing: border-box;
  min-width: 0;
  min-height: 44px;
  padding: var(--space-4, 4px) 0;
}

.weekday {
  max-width: 100%;
  font-size: 11px;
  line-height: 1.2;
  color: var(--ink-3, #6B7585);
  white-space: nowrap;
}

.day-num {
  width: 28px;
  height: 28px;
  margin-top: var(--space-2, 2px);
  border-radius: 50%;
  font-size: 14px;
  font-weight: 600;
  line-height: 28px;
  text-align: center;
  font-variant-numeric: tabular-nums;
}

.day.is-on .day-num {
  background: var(--primary, #1F4E89);
  color: #FFFFFF;
}

.day.is-today .day-num {
  color: var(--primary, #1F4E89);
}

.dot {
  width: 4px;
  height: 4px;
  margin-top: var(--space-2, 2px);
  border-radius: 50%;
  background: transparent;
}

.dot.is-on {
  background: var(--primary, #1F4E89);
}

.card-line {
  display: flex;
  align-items: center;
}

.card-line .time {
  flex: 0 1 auto;
  min-width: 0;
  margin-right: var(--space-8, 8px);
  font-size: 15px;
  font-weight: 600;
  line-height: 1.35;
}

.pill-host {
  flex: 0 1 auto;
  max-width: 58%;
  margin-left: auto;
}

.card-title {
  display: -webkit-box;
  margin-top: var(--space-4, 4px);
  overflow: hidden;
  font-size: 16px;
  font-weight: 600;
  line-height: 1.35;
  white-space: normal;
  word-break: break-word;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.card-sub {
  display: block;
  width: 100%;
  margin-top: var(--space-2, 2px);
  overflow: hidden;
  font-size: 13px;
  line-height: 1.45;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.card.is-link {
  padding-right: 28px;
}

.card-chev {
  position: absolute;
  top: 50%;
  right: var(--space-14, 14px);
  width: 8px;
  height: 8px;
  margin-top: calc(-1 * var(--space-4, 4px));
  border-right: 1.5px solid var(--icon, #8B95A5);
  border-bottom: 1.5px solid var(--icon, #8B95A5);
  transform: rotate(-45deg);
}

.card.is-focus {
  animation: focus-fade 1.2s ease;
}

@keyframes focus-fade {
  0% { background-color: var(--primary-soft, #E7F0FA); }
  55% { background-color: var(--primary-soft, #E7F0FA); }
  100% { background-color: var(--card, #FFFFFF); }
}

.is-pressed {
  background: #F7F9FB;
}
