.page {
  box-sizing: border-box;
  width: 100%;
  min-height: 100vh;
  padding: var(--space-12, 12px) var(--space-16, 16px) calc(var(--space-24, 24px) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--space-24, 24px) + env(safe-area-inset-bottom));
}

.field-input,
.picker-hit {
  box-sizing: border-box;
  width: 100%;
  min-height: 44px;
  line-height: 44px;
  text-align: right;
  font-size: 15px;
}

.picker-hit {
  display: block;
  word-break: break-word;
}

.field-area {
  box-sizing: border-box;
  width: 100%;
  min-height: 88px;
  padding: var(--space-8, 8px) 0;
  text-align: left;
  font-size: 15px;
  line-height: 1.45;
}

.chips {
  display: flex;
  flex-wrap: wrap;
}

.chips.is-locked {
  opacity: 0.55;
  pointer-events: none;
}

.person {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  min-height: 44px;
  margin: 0 var(--space-8, 8px) var(--space-8, 8px) 0;
  padding: var(--space-8, 8px) var(--space-12, 12px);
  border-radius: 999px;
  background: var(--mute-soft, #EEF1F5);
  color: var(--ink, #1C2430);
  font-size: 14px;
  line-height: 1.3;
}

.person.is-on {
  background: var(--primary-soft, #E7F0FA);
  color: var(--primary, #1F4E89);
  font-weight: 600;
}

.submit {
  margin-top: var(--space-16, 16px);
}

.sheet-copy {
  display: block;
  margin-bottom: var(--space-8, 8px);
  color: var(--ink-2, #5C6778);
  font-size: 14px;
  line-height: 1.5;
  white-space: normal;
  word-break: break-word;
  overflow-wrap: break-word;
}
