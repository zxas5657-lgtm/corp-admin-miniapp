page {
  background: #0E1C2E;
}

.page {
  position: relative;
  box-sizing: border-box;
  min-height: 100vh;
  color: var(--on-canvas, #FFFFFF);
}

.canvas-bg {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 0;
  background: linear-gradient(
    160deg,
    var(--canvas-a, #5A3320) 0%,
    var(--canvas-b, #3A2A2C) 55%,
    var(--canvas-c, #0E1C2E) 100%
  );
}

.nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 5;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  padding-left: var(--space-20, 20px);
  background: rgba(30, 32, 24, 0.72);
}

.who {
  display: inline-flex;
  align-items: center;
  max-width: 100%;
  box-sizing: border-box;
  padding: 0 var(--space-12, 12px) 0 var(--space-4, 4px);
  border: 1px solid var(--glass-line, rgba(255, 255, 255, 0.20));
  border-radius: var(--radius-pill, 999px);
  background: var(--glass, rgba(255, 255, 255, 0.14));
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 28px;
  height: 28px;
  margin-right: var(--space-8, 8px);
  border-radius: 50%;
  background: var(--highlight, #EBC9A6);
  color: var(--on-highlight, #4A2A14);
  font-size: 14px;
  font-weight: 600;
  line-height: 1;
}

.who-name {
  overflow: hidden;
  color: #FFFFFF;
  font-size: 15px;
  font-weight: 500;
  line-height: 1.2;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.body {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  padding-right: var(--space-20, 20px);
  padding-left: var(--space-20, 20px);
  padding-bottom: calc(108px + constant(safe-area-inset-bottom));
  padding-bottom: calc(108px + env(safe-area-inset-bottom));
}

.hero-row {
  display: flex;
  align-items: flex-start;
}

.hero-copy {
  flex: 1;
  min-width: 0;
  padding-top: var(--space-8, 8px);
}

.hero-title {
  display: block;
  color: #FFFFFF;
  font-size: 30px;
  font-weight: 400;
  line-height: 1.2;
}

.page.is-en .hero-title {
  font-size: 32px;
  letter-spacing: -0.02em;
}

.range {
  display: block;
  margin-top: var(--space-4, 4px);
  color: var(--on-canvas-2, rgba(255, 255, 255, 0.85));
  font-size: 17px;
  line-height: 1.35;
}

.cal {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
}

.cal-icon {
  box-sizing: border-box;
  width: 16px;
  height: 16px;
  padding-top: var(--space-4, 4px);
  border: 1.5px solid #FFFFFF;
  border-radius: 3px;
}

.cal-bar {
  height: 0;
  margin: 0 var(--space-2, 2px);
  border-top: 1.5px solid #FFFFFF;
}

.back {
  display: flex;
  align-items: center;
  min-height: 44px;
  color: #FFFFFF;
  font-size: 14px;
  font-weight: 600;
  line-height: 1.35;
}

.modes {
  display: flex;
  margin-top: var(--space-12, 12px);
  padding: var(--space-2, 2px);
  border: 1px solid var(--glass-line, rgba(255, 255, 255, 0.20));
  border-radius: var(--radius-pill, 999px);
  background: var(--glass, rgba(255, 255, 255, 0.14));
}

.mode {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  box-sizing: border-box;
  min-width: 0;
  min-height: 44px;
  padding: var(--space-6, 6px) var(--space-8, 8px);
  border-radius: var(--radius-pill, 999px);
  color: var(--on-canvas-2, rgba(255, 255, 255, 0.85));
  font-size: 15px;
  line-height: 1.3;
  text-align: center;
}

.mode.is-on {
  background: var(--glass-strong, rgba(255, 255, 255, 0.22));
  color: #FFFFFF;
  font-weight: 600;
}

.strip {
  display: flex;
  align-items: stretch;
  margin-top: var(--space-12, 12px);
  border: 1px solid var(--glass-line, rgba(255, 255, 255, 0.20));
  border-radius: var(--radius-glass, 24px);
  background: var(--glass, rgba(255, 255, 255, 0.14));
}

.nav-chev {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 36px;
  width: 36px;
  min-height: 44px;
}

.chevron {
  width: 8px;
  height: 8px;
  border-right: 1.5px solid #FFFFFF;
  border-bottom: 1.5px solid #FFFFFF;
}

.chevron.is-left {
  transform: rotate(135deg);
}

.chevron.is-right {
  transform: rotate(-45deg);
}

.days {
  display: flex;
  flex: 1;
  min-width: 0;
}

.day {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  box-sizing: border-box;
  min-width: 0;
  min-height: 64px;
  padding: var(--space-8, 8px) 0;
}

.weekday {
  max-width: 100%;
  color: #FFFFFF;
  font-size: 11px;
  font-weight: 500;
  line-height: 1.2;
  white-space: nowrap;
}

.day-num {
  width: 28px;
  height: 28px;
  margin-top: var(--space-2, 2px);
  border-radius: 50%;
  color: #FFFFFF;
  font-size: 14px;
  font-weight: 600;
  line-height: 28px;
  text-align: center;
  font-variant-numeric: tabular-nums;
}

.day.is-on .day-num {
  background: var(--highlight, #EBC9A6);
  color: var(--on-highlight, #4A2A14);
}

.day.is-today .day-num {
  color: var(--highlight, #EBC9A6);
}

.dot {
  width: 4px;
  height: 4px;
  margin-top: var(--space-2, 2px);
  border-radius: 50%;
  background: transparent;
}

.dot.is-on {
  background: var(--highlight, #EBC9A6);
}

.tiles {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: var(--space-12, 12px);
}

.tile {
  box-sizing: border-box;
  width: calc(50% - 6px);
  min-height: 104px;
  margin-bottom: var(--space-12, 12px);
  padding: var(--space-16, 16px);
  border: 1px solid var(--glass-line, rgba(255, 255, 255, 0.20));
  border-radius: var(--radius-glass, 24px);
  background: var(--glass, rgba(255, 255, 255, 0.14));
}

.tile.is-on {
  border-color: var(--highlight, #EBC9A6);
  background: var(--glass-strong, rgba(255, 255, 255, 0.22));
}

.tile-icon {
  width: 20px;
  height: 20px;
  filter: brightness(0) invert(1);
}

.tile-mark {
  width: 8px;
  height: 8px;
  margin-top: var(--space-6, 6px);
  border-radius: 50%;
  background: var(--highlight, #EBC9A6);
}

.tile-count {
  display: block;
  margin-top: var(--space-8, 8px);
  color: #FFFFFF;
  font-size: 24px;
  font-weight: 500;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}

.tile-label {
  display: block;
  margin-top: var(--space-4, 4px);
  color: #FFFFFF;
  font-size: 12px;
  font-weight: 500;
  line-height: 1.3;
}

.day-heading {
  display: block;
  margin: var(--space-4, 4px) 0 var(--space-8, 8px);
  color: #FFFFFF;
  font-size: 20px;
  font-weight: 500;
  line-height: 1.3;
}

.empty-line {
  display: block;
  margin: var(--space-8, 8px) 0 var(--space-12, 12px);
  color: #FFFFFF;
  font-size: 17px;
  line-height: 1.4;
}

.item-card {
  box-sizing: border-box;
  margin-bottom: var(--space-12, 12px);
  padding: var(--space-16, 16px);
  border: 1px solid var(--glass-line, rgba(255, 255, 255, 0.20));
  border-radius: var(--radius-glass, 24px);
  background: var(--glass, rgba(255, 255, 255, 0.14));
  color: #FFFFFF;
}

.item-card.is-open {
  background: var(--glass-strong, rgba(255, 255, 255, 0.22));
}

.item-card.is-cancelled {
  opacity: 0.6;
}

.item-card.is-pressed {
  background: var(--glass-strong, rgba(255, 255, 255, 0.22));
}

.item-main {
  display: flex;
  align-items: flex-start;
}

.time-col {
  flex: none;
  width: 96px;
  margin-right: var(--space-12, 12px);
}

.when {
  display: block;
  color: #FFFFFF;
  font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
  font-size: 15px;
  font-weight: 500;
  line-height: 1.3;
  font-variant-numeric: tabular-nums;
}

.zone {
  display: block;
  margin-top: var(--space-2, 2px);
  color: #FFFFFF;
  font-size: 12px;
  font-weight: 400;
  line-height: 1.35;
}

.item-copy {
  flex: 1;
  min-width: 0;
}

.item-title {
  display: block;
  color: #FFFFFF;
  font-size: 17px;
  font-weight: 500;
  line-height: 1.35;
  word-break: break-word;
}

.item-title.is-important {
  font-weight: 600;
}

.item-title.is-strike {
  text-decoration: line-through;
}

.meta {
  display: flex;
  align-items: flex-start;
  margin-top: var(--space-4, 4px);
}

.type-icon {
  flex: none;
  width: 16px;
  height: 16px;
  margin-top: 2px;
  margin-right: var(--space-6, 6px);
  filter: brightness(0) invert(1);
}

.meta-text {
  flex: 1;
  min-width: 0;
  color: var(--on-canvas-2, rgba(255, 255, 255, 0.85));
  font-size: 14px;
  line-height: 1.4;
  word-break: break-word;
}

.marks {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex: none;
  max-width: 42%;
  margin-left: var(--space-8, 8px);
}

.pill {
  display: block;
  box-sizing: border-box;
  max-width: 100%;
  margin-bottom: var(--space-4, 4px);
  padding: 2px var(--space-8, 8px);
  border-radius: var(--radius-pill, 999px);
  font-size: 12px;
  font-weight: 500;
  line-height: 1.4;
  text-align: center;
}

.pill-pending {
  background: var(--highlight, #EBC9A6);
  color: var(--on-highlight, #4A2A14);
}

.pill-important {
  border: 1px solid #FFFFFF;
  color: #FFFFFF;
}

.pill-cancelled {
  background: var(--cancel-soft, #F7E3E6);
  color: var(--cancel, #9B2C3C);
}

.updated {
  display: flex;
  align-items: center;
  margin-bottom: var(--space-4, 4px);
}

.updated-dot {
  flex: none;
  width: 6px;
  height: 6px;
  margin-right: var(--space-4, 4px);
  border-radius: 50%;
  background: var(--highlight, #EBC9A6);
}

.updated-text {
  color: var(--on-canvas-2, rgba(255, 255, 255, 0.85));
  font-size: 12px;
  font-weight: 500;
  line-height: 1.4;
}

.detail {
  max-height: 0;
  overflow: hidden;
  opacity: 0;
  transition: max-height 0.3s ease, opacity 0.3s ease;
}

.detail.is-open {
  max-height: 960px;
  opacity: 1;
}

.line {
  margin-top: var(--space-8, 8px);
}

.line-label {
  display: block;
  color: var(--on-canvas-2, rgba(255, 255, 255, 0.85));
  font-size: 12px;
  font-weight: 500;
  line-height: 1.35;
}

.line-value {
  display: block;
  margin-top: var(--space-2, 2px);
  color: #FFFFFF;
  font-size: 15px;
  line-height: 1.4;
  word-break: break-word;
}

.pair {
  display: flex;
  margin-top: var(--space-12, 12px);
}

.btn-solid,
.btn-glass {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  box-sizing: border-box;
  min-width: 0;
  min-height: 44px;
  padding: 0 var(--space-8, 8px);
  border-radius: var(--radius-btn, 16px);
  font-size: 16px;
  font-weight: 600;
  line-height: 1.2;
  text-align: center;
}

.btn-solid {
  margin-right: var(--space-8, 8px);
  background: #FFFFFF;
  color: var(--ink, #1B2230);
}

.btn-glass {
  border: 1px solid var(--glass-line, rgba(255, 255, 255, 0.20));
  background: var(--glass, rgba(255, 255, 255, 0.14));
  color: #FFFFFF;
}

.btn-solid.is-disabled,
.btn-glass.is-disabled {
  opacity: 0.45;
}

.sheet-area {
  box-sizing: border-box;
  width: 100%;
  min-height: 96px;
  padding: var(--space-8, 8px) 0;
  color: var(--ink, #1B2230);
  font-size: 15px;
  line-height: 1.45;
}

.sheet-meta {
  display: flex;
  align-items: flex-start;
}

.sheet-error {
  flex: 1;
  min-width: 0;
  color: var(--cancel, #9B2C3C);
  font-size: 13px;
  line-height: 1.4;
}

.sheet-count {
  margin-left: auto;
  padding-left: var(--space-8, 8px);
  color: var(--ink-3, #687284);
  font-size: 12px;
  line-height: 1.4;
  font-variant-numeric: tabular-nums;
}

.enter.is-play {
  animation: week-rise 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
}

@keyframes week-rise {
  from {
    opacity: 0;
    transform: translateY(16px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@supports ((backdrop-filter: blur(20px)) or (-webkit-backdrop-filter: blur(20px))) {
  .nav {
    background: rgba(14, 28, 46, 0.28);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
  }
}

@media (prefers-reduced-motion: reduce) {
  .enter.is-play {
    animation: none;
  }
  .detail {
    transition: none;
  }
}
