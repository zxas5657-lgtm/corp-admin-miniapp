.page {
  box-sizing: border-box;
  width: 100%;
  padding: var(--space-12, 12px) var(--space-16, 16px) 140px;
}

.tools {
  display: flex;
  flex-wrap: wrap;
}

.hit {
  box-sizing: border-box;
  min-height: 44px;
  margin: 0 var(--space-8, 8px) var(--space-8, 8px) 0;
  padding: 0 var(--space-12, 12px);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  background: #FFFFFF;
  color: var(--ink-2, #5C6778);
  font-size: 13px;
  line-height: 1.3;
  text-align: center;
}

.hit:nth-child(1),
.hit:nth-child(2) {
  flex: 1;
}

.pseudo {
  width: 100%;
  margin-right: 0;
}

.is-on {
  background: var(--primary, #1F4E89);
  color: #FFFFFF;
}

.panel {
  background: #FFFFFF;
  border-radius: 12px;
  margin-bottom: var(--space-12, 12px);
  overflow: hidden;
}

.pills {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: var(--space-8, 8px);
}

.pill-gap {
  display: inline-block;
  margin: 0 var(--space-8, 8px) var(--space-8, 8px) 0;
}

.gap {
  margin-top: var(--space-12, 12px);
}

.sheet-copy {
  display: block;
  color: var(--ink-2, #5C6778);
  font-size: 13px;
  line-height: 1.5;
}
