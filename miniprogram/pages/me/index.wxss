.page {
  box-sizing: border-box;
  width: 100%;
  min-height: 100vh;
  padding: 16px 16px calc(88px + constant(safe-area-inset-bottom));
  padding-bottom: calc(88px + env(safe-area-inset-bottom));
}

.profile {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  padding: 4px 4px 16px;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 56px;
  height: 56px;
  margin-right: 12px;
  border-radius: 50%;
  background: var(--primary-soft, #E7F0FA);
  color: var(--primary, #1F4E89);
  font-size: 22px;
  font-weight: 600;
  line-height: 1;
}

.profile-copy {
  flex: 1;
  min-width: 0;
}

.name {
  display: block;
  font-size: 20px;
  font-weight: 600;
  line-height: 1.35;
  word-break: break-word;
}

.meta {
  display: block;
  margin-top: 2px;
}

.entries {
  margin-top: 16px;
}

.demo-hint {
  display: block;
  margin: 0 4px 8px;
}

.role {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  min-height: 44px;
  padding: 12px 14px;
  border-bottom: 1px solid var(--line, #E6E9EE);
}

.role:last-child {
  border-bottom: 0;
}

.role-copy {
  flex: 1;
  min-width: 0;
  margin-right: 12px;
}

.role-label,
.role-name,
.role-hint,
.option-label {
  display: block;
  word-break: break-word;
  overflow-wrap: break-word;
}

.role-label {
  font-size: 15px;
  font-weight: 600;
  line-height: 1.4;
}

.role-name,
.role-hint {
  margin-top: 2px;
}

.is-pressed {
  background: var(--bg, #F3F5F8);
}

.reset {
  margin-top: 12px;
}

.option {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  min-height: 44px;
  padding: 10px 0;
  border-bottom: 1px solid var(--line, #E6E9EE);
}

.option-label {
  flex: 1;
  min-width: 0;
  margin-right: 12px;
  font-size: 16px;
  line-height: 1.4;
}

.tick {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 22px;
  height: 22px;
  box-sizing: border-box;
  border: 1.5px solid var(--line, #E6E9EE);
  border-radius: 50%;
}

.tick.is-on {
  border-color: var(--primary, #1F4E89);
  background: var(--primary, #1F4E89);
}

.tick-mark {
  width: 6px;
  height: 10px;
  margin-top: -2px;
  border-right: 2px solid #FFFFFF;
  border-bottom: 2px solid #FFFFFF;
  transform: rotate(45deg);
}

.sheet-copy {
  display: block;
  color: var(--ink-2, #5C6778);
  font-size: 13px;
  line-height: 1.5;
}
