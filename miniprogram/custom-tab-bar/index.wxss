.tab-bar {
  --primary: #1F4E89;
  --icon: #8B95A5;
  --line: #E6E9EE;
  --danger: #9F1D1D;
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  flex-direction: row;
  align-items: stretch;
  box-sizing: border-box;
  width: 100%;
  min-height: calc(64px + constant(safe-area-inset-bottom));
  min-height: calc(64px + env(safe-area-inset-bottom));
  padding: var(--space-4, 4px) 0 var(--space-14, 14px);
  padding-bottom: calc(var(--space-14, 14px) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--space-14, 14px) + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1px solid var(--line);
}

.tab-item {
  position: relative;
  flex: 1 1 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 0;
  min-height: 44px;
  padding: 0 var(--space-2, 2px);
  background: transparent;
  color: var(--icon);
  font-size: 11px;
  font-weight: 500;
  line-height: 14px;
}

.tab-item.is-on {
  background: transparent;
  color: var(--primary);
}

.tab-icon-wrap {
  position: relative;
  width: 24px;
  height: 24px;
  flex-shrink: 0;
}

.tab-icon {
  width: 24px;
  height: 24px;
}

.tab-label {
  display: block;
  margin-top: var(--space-2, 2px);
  max-width: none;
  font-size: 11px;
  font-weight: 500;
  line-height: 14px;
  white-space: nowrap;
  overflow: visible;
  text-overflow: clip;
}

.tab-badge {
  position: absolute;
  top: calc(-1 * var(--space-4, 4px));
  left: var(--space-14, 14px);
  min-width: 16px;
  height: 16px;
  padding: 0 var(--space-4, 4px);
  border-radius: 8px;
  background: var(--danger);
  color: #FFFFFF;
  font-size: 10px;
  font-weight: 600;
  line-height: 16px;
  text-align: center;
  font-variant-numeric: tabular-nums;
  box-sizing: border-box;
}
