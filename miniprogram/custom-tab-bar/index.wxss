@import "../styles/seasons.wxss";

.tab-bar {
  --ink: #1B2230;
  --line: #E3E6EB;
  --cancel: #9B2C3C;
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  flex-direction: row;
  align-items: stretch;
  box-sizing: border-box;
  width: 100%;
  min-height: calc(64px + constant(safe-area-inset-bottom));
  min-height: calc(64px + env(safe-area-inset-bottom));
  padding: var(--space-4, 4px) 0 var(--space-6, 6px);
  padding-bottom: calc(var(--space-6, 6px) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--space-6, 6px) + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1px solid var(--line);
}

.tab-bar.is-hidden {
  display: none;
}

.tab-item {
  position: relative;
  flex: 1 1 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 0;
  min-height: 44px;
  padding: 0 var(--space-2, 2px);
  background: transparent;
  color: var(--ink);
  font-size: 11px;
  font-weight: 500;
  line-height: 14px;
}

.tab-icon,
.tab-label {
  opacity: 0.62;
}

.tab-item.is-on .tab-icon,
.tab-item.is-on .tab-label {
  opacity: 1;
}

.tab-icon-wrap {
  position: relative;
  width: 24px;
  height: 24px;
  flex-shrink: 0;
}

.tab-icon {
  width: 24px;
  height: 24px;
}

.tab-label {
  display: block;
  margin-top: var(--space-2, 2px);
  max-width: none;
  font-size: 11px;
  font-weight: 500;
  line-height: 14px;
  white-space: nowrap;
  overflow: visible;
  text-overflow: clip;
}

.tab-dot {
  width: 4px;
  height: 4px;
  margin-top: 2px;
  border-radius: 50%;
  background: var(--accent, #8A4A22);
}

.tab-plus {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 44px;
  height: 44px;
  border: 1px solid var(--line, #E3E6EB);
  border-radius: 999px;
  background: #FFFFFF;
}

.plus-mark {
  color: var(--ink, #1B2230);
  font-size: 24px;
  font-weight: 500;
  line-height: 44px;
}

.tab-badge {
  position: absolute;
  top: calc(-1 * var(--space-4, 4px));
  left: var(--space-14, 14px);
  min-width: 16px;
  height: 16px;
  padding: 0 var(--space-4, 4px);
  border-radius: 8px;
  background: var(--cancel);
  color: #FFFFFF;
  font-size: 10px;
  font-weight: 600;
  line-height: 16px;
  text-align: center;
  font-variant-numeric: tabular-nums;
  box-sizing: border-box;
}

.tab-bar.is-canvas {
  background: rgba(30, 32, 24, 0.72);
  border-top-color: transparent;
  color: var(--on-canvas, #FFFFFF);
}

.tab-bar.is-canvas .tab-item {
  color: var(--on-canvas, #FFFFFF);
}

.tab-bar.is-canvas .tab-icon {
  filter: brightness(0) invert(1);
}

.tab-bar.is-canvas .tab-dot {
  background: var(--highlight, #EBC9A6);
}

.tab-bar.is-canvas .tab-plus {
  border-color: transparent;
  background: #FFFFFF;
}

@supports ((backdrop-filter: blur(20px)) or (-webkit-backdrop-filter: blur(20px))) {
  .tab-bar.is-canvas {
    background: rgba(14, 28, 46, 0.55);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
  }
}
