<view class="tab-bar {{hidden ? 'is-hidden' : ''}}">
  <view
    class="tab-item {{selected === index ? 'is-on' : ''}}"
    wx:for="{{list}}"
    wx:key="key"
    data-index="{{index}}"
    hover-class="none"
    bindtap="onTap"
  >
    <view wx:if="{{item.plus}}" class="tab-plus" aria-role="button">
      <text class="plus-mark">+</text>
    </view>
    <block wx:else>
      <view class="tab-icon-wrap">
        <image
          class="tab-icon"
          src="{{selected === index ? item.activeIcon : item.icon}}"
          mode="aspectFit"
        />
        <text class="tab-badge" wx:if="{{badges[index] > 0}}">{{badges[index]}}</text>
      </view>
      <text class="tab-label">{{item.text}}</text>
    </block>
  </view>
</view>
