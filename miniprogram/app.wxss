@import "styles/seasons.wxss";

page {
  --bg: #F4F5F7;
  --card: #FFFFFF;
  --ink: #1B2230;
  --ink-2: #4F5868;
  --ink-3: #687284;
  --icon: #98A1AF;
  --line: #E3E6EB;
  --mute: #5E6676;
  --mute-soft: #ECEEF2;
  --cancel: #9B2C3C;
  --cancel-soft: #F7E3E6;
  --disabled: #C9CED6;
  --canvas-c: #0E1C2E;
  --glass: rgba(255, 255, 255, 0.14);
  --glass-strong: rgba(255, 255, 255, 0.22);
  --glass-line: rgba(255, 255, 255, 0.20);
  --on-canvas: #FFFFFF;
  --on-canvas-2: rgba(255, 255, 255, 0.85);
  --on-canvas-3: rgba(255, 255, 255, 0.70);
  --accent: #8A4A22;
  --accent-press: #6E3A1A;
  --accent-soft: #F5E9DF;
  --canvas-a: #5A3320;
  --canvas-b: #3A2A2C;
  --highlight: #EBC9A6;
  --on-highlight: #4A2A14;
  --shadow: 0 1px 2px rgba(27, 34, 48, 0.04);
  --radius-sm: 8px;
  --radius: 16px;
  --radius-btn: 16px;
  --radius-sheet: 24px;
  --radius-glass: 24px;
  --radius-pill: 999px;
  --space-2: 2px;
  --space-4: 4px;
  --space-6: 6px;
  --space-8: 8px;
  --space-10: 10px;
  --space-12: 12px;
  --space-14: 14px;
  --space-16: 16px;
  --space-20: 20px;
  --space-24: 24px;
  --space-32: 32px;
  background: var(--bg);
  color: var(--ink);
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, "PingFang SC", "Hiragino Sans GB", "Noto Sans SC", "Microsoft YaHei", sans-serif;
  font-size: 15px;
  font-weight: 400;
  line-height: 1.45;
  -webkit-font-smoothing: antialiased;
}

.text-nav {
  font-size: 17px;
  font-weight: 600;
  line-height: 1.45;
}

.text-detail {
  font-size: 20px;
  font-weight: 600;
  line-height: 1.35;
}

.text-title {
  font-size: 16px;
  font-weight: 600;
  line-height: 1.35;
}

.text-body {
  font-size: 15px;
  font-weight: 400;
  line-height: 1.45;
}

.text-secondary {
  font-size: 13px;
  font-weight: 400;
  line-height: 1.45;
  color: var(--ink-2);
}

.text-aux {
  font-size: 12px;
  font-weight: 400;
  line-height: 1.45;
}

.text-tab {
  font-size: 11px;
  font-weight: 500;
  line-height: 1.2;
}

.time,
.tabular {
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
}

button,
input,
textarea {
  font-family: inherit;
  font-size: inherit;
  color: inherit;
  box-sizing: border-box;
}

.card {
  position: relative;
  display: block;
  box-sizing: border-box;
  width: 100%;
  max-width: 100%;
  background: var(--card);
  border-radius: var(--radius);
  padding: var(--space-12) var(--space-14);
  margin-bottom: var(--space-10);
  color: inherit;
  box-shadow: var(--shadow);
}

.section-label {
  margin: var(--space-14) var(--space-4) var(--space-8);
  font-size: 12px;
  font-weight: 600;
  line-height: 1.45;
  color: var(--ink-3);
}

.sub {
  display: block;
  margin-top: var(--space-2);
  color: var(--ink-3);
  font-size: 12px;
  font-weight: 400;
  line-height: 1.45;
}

.fine {
  display: block;
  margin: var(--space-8) 0 0;
  font-size: 12px;
  font-weight: 400;
  line-height: 1.45;
  color: var(--ink-3);
  text-align: center;
}

.type-line {
  display: flex;
  align-items: center;
  min-width: 0;
  margin-top: var(--space-4);
}

.type-icon {
  width: 16px;
  height: 16px;
  margin-right: var(--space-6);
  flex: none;
}

.type-label {
  min-width: 0;
  color: var(--ink-2);
  font-size: 13px;
  line-height: 1.4;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cell-group {
  box-sizing: border-box;
  width: 100%;
  max-width: 100%;
  background: var(--card);
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: var(--shadow);
}

.cell {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  width: 100%;
  max-width: 100%;
  min-height: 48px;
  padding: var(--space-12) var(--space-14);
  border-bottom: 1px solid var(--line);
}

.cell:last-child {
  border-bottom: 0;
}

.cell .k,
.cell .cell-label {
  flex: 0 1 auto;
  min-width: 72px;
  max-width: 45%;
  font-size: 15px;
  line-height: 1.4;
  white-space: normal;
  word-break: break-word;
  overflow-wrap: break-word;
}

.cell .v,
.cell .cell-value {
  flex: 1;
  min-width: 0;
  margin-left: var(--space-12);
  text-align: right;
  font-size: 15px;
  line-height: 1.4;
  word-break: break-word;
  overflow-wrap: break-word;
}

.cell-body {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.cell--stacked .cell-body {
  flex-direction: column;
  align-items: stretch;
}

.cell--stacked .k,
.cell--stacked .cell-label {
  min-width: 0;
  max-width: 100%;
  width: auto;
}

.cell--stacked .v,
.cell--stacked .cell-value {
  width: 100%;
  margin-left: 0;
  margin-top: var(--space-4);
  text-align: left;
}

.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  max-width: 100%;
  height: 52px;
  margin: 0;
  padding: 0 var(--space-16);
  border: 1px solid transparent;
  border-radius: var(--radius-btn);
  background: var(--accent);
  color: #FFFFFF;
  font-size: 16px;
  font-weight: 600;
  line-height: 1.2;
  text-align: center;
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  background: var(--accent-press);
}

.btn-primary[disabled],
.btn-primary.is-disabled {
  opacity: 1;
  background: #FFFFFF;
  color: var(--disabled);
  border-color: var(--line);
}

.btn-primary[disabled]:active,
.btn-primary.is-disabled:active {
  background: #FFFFFF;
  color: var(--disabled);
}

.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.page-empty {
  box-sizing: border-box;
  width: 100%;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: var(--space-32);
  padding-right: var(--space-16);
  padding-left: var(--space-16);
  padding-bottom: calc(88px + constant(safe-area-inset-bottom));
  padding-bottom: calc(88px + env(safe-area-inset-bottom));
  text-align: center;
}
