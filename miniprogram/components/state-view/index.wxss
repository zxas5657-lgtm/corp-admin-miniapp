.state {
  box-sizing: border-box;
  width: 100%;
  padding: var(--space-32, 32px) var(--space-8, 8px) var(--space-12, 12px);
  text-align: center;
}

.mark {
  width: 56px;
  height: 56px;
  margin: 0 auto var(--space-12, 12px);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mark-empty {
  background: var(--mute-soft, #ECEEF2);
}

.mark-error {
  background: var(--cancel-soft, #F7E3E6);
}

.mark-success {
  background: var(--accent-soft, #F5E9DF);
}

.dash {
  width: 16px;
  height: 3px;
  border-radius: 2px;
  background: var(--ink-3, #687284);
}

.bang {
  position: relative;
  width: 3px;
  height: 16px;
  margin-top: calc(-1 * var(--space-6, 6px));
  border-radius: 2px;
  background: var(--cancel, #9B2C3C);
}

.bang::after {
  content: "";
  position: absolute;
  left: 0;
  top: 20px;
  width: 3px;
  height: 3px;
  border-radius: 50%;
  background: var(--cancel, #9B2C3C);
}

.check {
  width: 10px;
  height: 18px;
  margin-top: calc(-1 * var(--space-4, 4px));
  border-right: 2px solid var(--accent, #8A4A22);
  border-bottom: 2px solid var(--accent, #8A4A22);
  transform: rotate(45deg);
}

.body {
  display: block;
  margin-top: var(--space-6, 6px);
}

.action {
  margin-top: var(--space-16, 16px);
  overflow: hidden;
}

.secondary {
  min-height: 44px;
  margin-top: var(--space-4, 4px);
  padding: 0 var(--space-12, 12px);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--accent, #8A4A22);
  font-size: 15px;
  font-weight: 600;
  line-height: 1.3;
}

.skel {
  height: 14px;
  width: 72%;
  margin: var(--space-10, 10px) auto 0;
  border-radius: 7px;
  background: linear-gradient(90deg, #E3E6EB, #F7F8FA, #E3E6EB);
  background-size: 200% 100%;
  animation: state-sheen 1.1s ease infinite;
}

.skel-short {
  width: 48%;
}

@keyframes state-sheen {
  from { background-position: 100% 0; }
  to { background-position: -100% 0; }
}

.state.is-canvas .text-title,
.state.is-canvas .body {
  color: var(--on-canvas, #FFFFFF);
}

.state.is-canvas .body {
  color: var(--on-canvas-2, rgba(255, 255, 255, 0.85));
}

.state.is-canvas .mark-empty {
  background: var(--glass, rgba(255, 255, 255, 0.14));
}

.state.is-canvas .dash {
  background: var(--on-canvas, #FFFFFF);
}

.state.is-canvas .action {
  background: #FFFFFF;
  color: var(--ink, #1B2230);
}

.state.is-canvas .action:active {
  background: rgba(255, 255, 255, 0.85);
}

.state.is-canvas .secondary {
  color: var(--on-canvas, #FFFFFF);
}

.state.is-canvas .skel {
  background: linear-gradient(
    90deg,
    rgba(255, 255, 255, 0.16),
    rgba(255, 255, 255, 0.36),
    rgba(255, 255, 255, 0.16)
  );
  background-size: 200% 100%;
}

@media (prefers-reduced-motion: reduce) {
  .skel {
    animation: none;
  }
}
