.state {
  box-sizing: border-box;
  width: 100%;
  padding: 32px 8px 12px;
  text-align: center;
}

.mark {
  width: 56px;
  height: 56px;
  margin: 0 auto 12px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mark-empty {
  background: var(--mute-soft, #EEF1F5);
}

.mark-error {
  background: var(--danger-soft, #FDECEC);
}

.mark-success {
  background: var(--ok-soft, #E7F6EE);
}

.dash {
  width: 16px;
  height: 3px;
  border-radius: 2px;
  background: var(--ink-3, #6B7585);
}

.bang {
  position: relative;
  width: 3px;
  height: 16px;
  margin-top: -6px;
  border-radius: 2px;
  background: var(--danger, #9F1D1D);
}

.bang::after {
  content: "";
  position: absolute;
  left: 0;
  top: 20px;
  width: 3px;
  height: 3px;
  border-radius: 50%;
  background: var(--danger, #9F1D1D);
}

.check {
  width: 10px;
  height: 18px;
  margin-top: -4px;
  border-right: 2px solid var(--ok, #146C3F);
  border-bottom: 2px solid var(--ok, #146C3F);
  transform: rotate(45deg);
}

.body {
  display: block;
  margin-top: 6px;
}

.action {
  margin-top: 16px;
  overflow: hidden;
}

.secondary {
  min-height: 44px;
  margin-top: 4px;
  padding: 0 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--primary, #1F4E89);
  font-size: 15px;
  font-weight: 600;
  line-height: 1.3;
}

.skel {
  height: 14px;
  width: 72%;
  margin: 10px auto 0;
  border-radius: 7px;
  background: linear-gradient(90deg, #E6E9EE, #F7F9FB, #E6E9EE);
  background-size: 200% 100%;
  animation: state-sheen 1.1s ease infinite;
}

.skel-short {
  width: 48%;
}

@keyframes state-sheen {
  from { background-position: 100% 0; }
  to { background-position: -100% 0; }
}

@media (prefers-reduced-motion: reduce) {
  .skel {
    animation: none;
  }
}
