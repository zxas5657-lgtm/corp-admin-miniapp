<view class="state {{surface === 'canvas' ? 'is-canvas' : ''}}">
  <block wx:if="{{kind === 'loading'}}">
    <view class="skel"></view>
    <view class="skel skel-short"></view>
    <view class="skel"></view>
  </block>
  <view wx:if="{{kind !== 'loading'}}" class="mark mark-{{kind}}" aria-hidden="true">
    <view wx:if="{{kind === 'success'}}" class="check"></view>
    <view wx:elif="{{kind === 'error'}}" class="bang"></view>
    <view wx:else class="dash"></view>
  </view>
  <text wx:if="{{title}}" class="text-title">{{title}}</text>
  <text wx:if="{{body}}" class="text-secondary body">{{body}}</text>
  <view
    wx:if="{{actionText}}"
    class="btn-primary action"
    aria-role="button"
    catchtap="onAction"
  >{{actionText}}<text wx:if="{{surface === 'canvas'}}"> →</text></view>
  <view
    wx:if="{{secondaryText}}"
    class="secondary"
    aria-role="button"
    catchtap="onSecondary"
  >{{secondaryText}}</view>
</view>
