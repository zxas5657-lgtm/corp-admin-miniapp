.wrap {
  width: 100%;
  box-sizing: border-box;
}

.cell {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 48px;
}

.cell-body {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.cell--stacked .cell-body {
  flex-direction: column;
  align-items: stretch;
}

.catcher {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
}

.k {
  flex: 0 1 auto;
  min-width: 72px;
  max-width: 45%;
  font-size: 15px;
  line-height: 1.4;
  white-space: normal;
  word-break: break-word;
  overflow-wrap: break-word;
}

.v {
  flex: 1;
  min-width: 0;
  word-break: break-word;
  overflow-wrap: break-word;
}

.cell--stacked .k {
  min-width: 0;
  max-width: 100%;
}

.is-arrow {
  align-items: center;
}

.chev {
  width: 8px;
  height: 8px;
  margin-left: var(--space-8, 8px);
  flex-shrink: 0;
  border-right: 1.5px solid var(--icon, #8B95A5);
  border-bottom: 1.5px solid var(--icon, #8B95A5);
  transform: rotate(-45deg);
}

.is-hover {
  background: #F7F9FB;
}

.is-invalid {
  background: var(--cancel-soft, #F7E3E6);
  box-shadow: inset 0 0 0 1px var(--cancel, #9B2C3C);
}

.is-invalid .cell {
  background: transparent;
}

.err {
  display: block;
  padding: 0 var(--space-14, 14px) var(--space-12, 12px);
  color: var(--cancel, #9B2C3C);
  font-size: 12px;
  line-height: 1.4;
  text-align: left;
  word-break: break-word;
  overflow-wrap: break-word;
}
