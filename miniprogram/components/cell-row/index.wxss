.wrap {
  width: 100%;
  box-sizing: border-box;
}

.cell {
  min-height: 48px;
}

.k {
  flex: 0 1 auto;
  min-width: 72px;
  max-width: 45%;
  font-size: 15px;
  line-height: 1.4;
  white-space: normal;
  word-break: break-word;
  overflow-wrap: break-word;
}

.v {
  flex: 1;
  min-width: 0;
  word-break: break-word;
  overflow-wrap: break-word;
}

.cell--stacked .k {
  min-width: 0;
  max-width: 100%;
}

.is-arrow {
  align-items: center;
}

.chev {
  width: 8px;
  height: 8px;
  margin-left: 8px;
  flex-shrink: 0;
  border-right: 1.5px solid var(--icon, #8B95A5);
  border-bottom: 1.5px solid var(--icon, #8B95A5);
  transform: rotate(-45deg);
}

.is-hover {
  background: #F7F9FB;
}

.is-invalid {
  background: var(--danger-soft, #FDECEC);
  box-shadow: inset 0 0 0 1px var(--danger, #9F1D1D);
}

.is-invalid .cell {
  background: transparent;
}

.err {
  display: block;
  padding: 0 14px 12px;
  color: var(--danger, #9F1D1D);
  font-size: 12px;
  line-height: 1.4;
  text-align: left;
  word-break: break-word;
  overflow-wrap: break-word;
}
