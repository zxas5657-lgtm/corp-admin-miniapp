.sheet {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 3000;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(18, 24, 32, 0.45);
}

.panel {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  width: 100%;
  max-height: 78%;
  overflow: auto;
  padding: var(--space-8, 8px) var(--space-16, 16px) var(--space-16, 16px);
  padding-bottom: calc(var(--space-16, 16px) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--space-16, 16px) + env(safe-area-inset-bottom));
  border-radius: 16px 16px 0 0;
  background: #FFFFFF;
}

.handle {
  width: 36px;
  height: 4px;
  margin: var(--space-4, 4px) auto var(--space-12, 12px);
  border-radius: 4px;
  background: #D8DEE6;
}

.title {
  display: block;
  margin: 0 0 var(--space-12, 12px);
  text-align: center;
  font-size: 17px;
  font-weight: 600;
  line-height: 1.45;
  color: var(--ink, #1C2430);
}

.summary {
  display: block;
  color: var(--ink-2, #5C6778);
  font-size: 14px;
  line-height: 1.5;
}

.link {
  display: block;
  margin-top: var(--space-12, 12px);
  color: var(--accent, #8A4A22);
  font-size: 15px;
  font-weight: 600;
  line-height: 1.4;
}

.actions {
  display: flex;
  margin-top: var(--space-16, 16px);
}

.cancel,
.agree {
  flex: 1;
  min-width: 0;
  height: 44px;
  box-sizing: border-box;
  margin: 0;
  padding: 0 var(--space-12, 12px);
  border-radius: 8px;
  font-size: 16px;
  font-weight: 600;
  line-height: 44px;
  text-align: center;
}

.cancel {
  margin-right: var(--space-8, 8px);
  border: 1px solid var(--line, #E6E9EE);
  background: #FFFFFF;
  color: var(--ink, #1C2430);
}

.agree {
  border: 1px solid transparent;
  background: var(--accent, #8A4A22);
  color: #FFFFFF;
}

.agree::after {
  border: none;
}

.agree.is-pressed {
  background: var(--accent-press, #6E3A1A);
}
