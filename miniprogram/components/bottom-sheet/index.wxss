.sheet {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(18, 24, 32, 0.45);
}

.panel {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  width: 100%;
  max-height: 78%;
  overflow: auto;
  padding: var(--space-8, 8px) var(--space-16, 16px) var(--space-16, 16px);
  padding-bottom: calc(var(--space-16, 16px) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--space-16, 16px) + env(safe-area-inset-bottom));
  border-radius: 24px 24px 0 0;
  background: #FFFFFF;
  transform: translateY(100%);
  transition: transform 200ms ease;
}

.is-on .panel {
  transform: translateY(0);
}

.handle {
  width: 36px;
  height: 4px;
  margin: var(--space-4, 4px) auto var(--space-12, 12px);
  border-radius: 4px;
  background: #D8DEE6;
}

.title {
  display: block;
  margin: 0 0 var(--space-12, 12px);
  text-align: center;
  font-size: 17px;
  font-weight: 600;
  line-height: 1.45;
  color: var(--ink, #1B2230);
}

.body {
  min-width: 0;
}

.actions {
  display: flex;
  margin-top: var(--space-16, 16px);
}

.cancel,
.confirm {
  flex: 1;
  min-width: 0;
  min-height: 44px;
  box-sizing: border-box;
  overflow: hidden;
}

.action-label {
  display: block;
  width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  text-align: center;
}

.cancel {
  margin-right: var(--space-8, 8px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 var(--space-16, 16px);
  border: 1px solid var(--line, #E6E9EE);
  border-radius: 16px;
  background: #FFFFFF;
  color: var(--ink, #1B2230);
  font-size: 16px;
  font-weight: 600;
  line-height: 1.2;
  text-align: center;
}

.confirm.is-danger {
  background: var(--cancel, #9B2C3C);
  color: #FFFFFF;
  border-color: transparent;
}

.confirm.is-disabled,
.confirm.is-disabled:active {
  background: #FFFFFF;
  color: var(--ink-3, #6B7585);
  border-color: var(--line, #E6E9EE);
}

@media (prefers-reduced-motion: reduce) {
  .panel {
    transition: none;
  }
}
