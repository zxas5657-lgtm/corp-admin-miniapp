.sheet {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(18, 24, 32, 0.45);
}

.panel {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  width: 100%;
  max-height: 78%;
  overflow: auto;
  padding: 8px 16px 16px;
  padding-bottom: calc(16px + constant(safe-area-inset-bottom));
  padding-bottom: calc(16px + env(safe-area-inset-bottom));
  border-radius: 16px 16px 0 0;
  background: #FFFFFF;
  transform: translateY(100%);
  transition: transform 200ms ease;
}

.is-on .panel {
  transform: translateY(0);
}

.handle {
  width: 36px;
  height: 4px;
  margin: 4px auto 12px;
  border-radius: 4px;
  background: #D8DEE6;
}

.title {
  display: block;
  margin: 0 0 12px;
  text-align: center;
  font-size: 17px;
  font-weight: 600;
  line-height: 1.45;
  color: var(--ink, #1C2430);
}

.body {
  min-width: 0;
}

.actions {
  display: flex;
  margin-top: 16px;
}

.cancel,
.confirm {
  flex: 1;
  min-height: 44px;
  box-sizing: border-box;
}

.cancel {
  margin-right: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 16px;
  border: 1px solid var(--line, #E6E9EE);
  border-radius: 8px;
  background: #FFFFFF;
  color: var(--ink, #1C2430);
  font-size: 16px;
  font-weight: 600;
  line-height: 1.2;
  text-align: center;
}

.confirm.is-danger {
  background: var(--danger, #9F1D1D);
  color: #FFFFFF;
  border-color: transparent;
}

.confirm.is-disabled,
.confirm.is-disabled:active {
  background: #FFFFFF;
  color: var(--ink-3, #6B7585);
  border-color: var(--line, #E6E9EE);
}

@media (prefers-reduced-motion: reduce) {
  .panel {
    transition: none;
  }
}
