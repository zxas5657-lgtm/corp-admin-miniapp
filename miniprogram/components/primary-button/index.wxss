.wrap {
  box-sizing: border-box;
  width: 100%;
}

.is-fixed {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: var(--space-10, 10px) var(--space-16, 16px);
  padding-bottom: calc(var(--space-10, 10px) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--space-10, 10px) + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1px solid var(--line, #E6E9EE);
}
